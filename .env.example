# Backend
PORT=4000
REDIS_URL=redis://localhost:6379
POLL_INTERVAL_MS=5000
STALE_AFTER_SECONDS=180

# ngsi usa a fonte publica FIWARE/Porto Digital. mock usa veiculos simulados.
FEED_SOURCE=ngsi
NGSI_VEHICLE_POSITIONS_URL=https://broker.fiware.urbanplatform.portodigital.pt/v2/entities?q=vehicleType==bus&limit=1000
GTFS_STATIC_URL=https://opendata.porto.digital/dataset/5275c986-592c-43f5-8f87-aabbd4e4f3a4/resource/415bf8d5-4c18-40b3-9516-9d9187185ef9/download/gtfs_stcp.zip
METRO_GTFS_STATIC_URL=https://opendata.porto.digital/dataset/15f22603-a216-492a-ab1c-40b1d8aa2f08/resource/5e2b445d-b85b-4afb-9116-90b24327151c/download/___

# Opcional: usar GTFS-Realtime VehiclePositions em vez de NGSI.
GTFS_RT_VEHICLE_POSITIONS_URL=
GTFS_RT_AUTH_HEADER=

# Frontend
VITE_SOCKET_URL=http://localhost:4000
