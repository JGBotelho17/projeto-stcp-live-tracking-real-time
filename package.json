{
  "name": "stcp-live-tracker",
  "private": true,
  "version": "0.1.0",
  "description": "Aplicacao web de monitorizacao em tempo real dos autocarros da STCP.",
  "scripts": {
    "dev": "pnpm --parallel --filter @stcp-live/backend --filter @stcp-live/frontend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
